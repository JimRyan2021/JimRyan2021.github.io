    {
      "cell_type": "code",
      "source": [
        "from statsforecast import StatsForecast\n",
        "from statsforecast.models import Naive, HistoricAverage, WindowAverage, SeasonalNaive\n",
        "\n"
      ],
      "metadata": {
        "id": "2ShAKvA6B2rF"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "with statsforecast can fit many models at same time just pass a list of models to fit at same time\n",
        "window_size sets window to forecast\n",
        "\n",
        "for SeasonalNaive inport season length wihic is 7 days according to plot\n"
      ],
      "metadata": {
        "id": "MOoE9O02IafX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "horizon = 7\n",
        "#Daily Data next 7 days foreecast\n",
        "\n",
        "models = [\n",
        "    Naive(),\n",
        "    HistoricAverage(),\n",
        "    WindowAverage(window_size=7),\n",
        "    SeasonalNaive(season_length=7)\n",
        "]\n",
        "#initialize statforecast object sf\n",
        "#Specify Frequency of data which is Daily\n",
        "\n",
        "sf =StatsForecast(models=models,freq=\"D\" )\n",
        "sf.fit(df=df)\n",
        "preds= sf.predict(h=horizon)"
      ],
