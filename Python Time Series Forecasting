      "source": [
        "Cross-validation with time series is diffrerent as it is ordered in time.need to keep it is order\n",
        "forecast by window ubntil you run out of data or reach max # of windows in design\n"
      ],
      "metadata": {
        "id": "wmMEbJfigkOx"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "small_df = df[df[\"unique_id\"].isin(unique_ids)]\n",
        "\n",
        "models = [\n",
        "    SeasonalNaive(season_length=7),\n",
        "    AutoARIMA(seasonal=False, alias=\"ARIMA\"),\n",
        "    AutoARIMA(season_length=7, alias=\"SARIMA\")\n",
        "]\n",
        "\n",
        "sf = StatsForecast(models=models, freq=\"D\")\n",
        "cv_df = sf.cross_validation(\n",
        "    h=horizon, # 7 days\n",
        "    df=small_df,\n",
        "    n_windows=8, #56 points per series to eval\n",
        "    step_size=horizon, #determines diff between starting date of each window if setp_side < horizon overlapping windows - means more points\n",
        "    #step_side = horizon usually best way to go\n",
        "    refit=True #refit parameter determines if you want to refit model each time input size changes\n",
        ")\n",
        "\n",
        "cv_df.head(30)"
